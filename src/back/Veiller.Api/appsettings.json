{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Firebase": {
    "ProjectId": "",
    "WebApiKey": ""
  },
  "HealthSync": {
    "MaxItemsPerRequest": 5000,
    "MaxBodyBytes": 1048576,
    "FutureTolerance": "00:05:00",
    "WatchConnectedWindow": "06:00:00"
  },
  "Alerts": {
    "WorkerEnabled": true,
    "EvaluationInterval": "00:15:00",
    "HeartRateFreshness": "00:30:00",
    "HeartRateHigh": 120,
    "HeartRateLow": 40,
    "SleepLowMinutes": 240,
    "NoSyncMinutes": 360
  },
  "Retention": {
    "Enabled": true,
    "HealthDataDays": 365,
    "Interval": "24:00:00"
  },
  "AllowedHosts": "*"
}
