{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Firebase": {
    "ProjectId": "",
    "WebApiKey": ""
  },
  "HealthSync": {
    "MaxItemsPerRequest": 5000,
    "MaxBodyBytes": 1048576,
    "FutureTolerance": "00:05:00",
    "WatchConnectedWindow": "06:00:00"
  },
  "AllowedHosts": "*"
}
